@model IEnumerable<_31241023460_NguyenThanhLiem.Models.Movie>

@{
    ViewData["Title"] = "Danh sách phim";
}

<h2>31241023460 - Nguyễn Thanh Liêm</h2>

<div class="d-flex gap-2 mb-4">
    <a asp-action="Create" class="btn btn-primary">
        Thêm phim
    </a>
    <a asp-controller="Genres" asp-action="Index"
       class="btn btn-outline-secondary">
        Quản lý thể loại
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100">
                <img src="@item.PicturePath"
                     alt="@item.Title"
                     class="card-img-top"
                     style="height: 240px; object-fit: contain;" />

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Title</h5>

                    <p class="mb-2">
                        Thể loại:
                        @(item.GenreObj?.Name ?? "Chưa phân loại")
                    </p>

                    <p class="mb-2">
                        Xếp hạng: @(item.Rated) / 5
                    </p>

                    <p class="fw-bold">
                        Giá: @item.Price.ToString("N0") đ
                    </p>

                    <a asp-controller="Movies"
                       asp-action="AddToCart"
                       asp-route-id="@item.ID"
                       class="btn btn-success mt-auto">
                        Mua
                    </a>
                </div>

                <div class="card-footer d-flex gap-3">
                    <a asp-action="Edit" asp-route-id="@item.ID">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.ID">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.ID">Xóa</a>
                </div>
            </div>
        </div>
    }
</div>