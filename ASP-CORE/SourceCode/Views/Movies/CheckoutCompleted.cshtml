@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<h2>Thanks!</h2>

<div class="alert alert-success">
    Đơn hàng của bạn đã được lưu thành công.
    <br />
    <strong>Mã đơn hàng: @ViewBag.OrderId</strong>
</div>

@if (ViewBag.EmailSent == true)
{
    <p>Email xác nhận đã được gửi đến địa chỉ bạn nhập.</p>
}
else
{
    <div class="alert alert-warning">
        Đơn hàng đã được lưu, nhưng chưa gửi được email xác nhận.
    </div>
}

<a asp-controller="Movies"
   asp-action="Index"
   class="btn btn-primary">
    Tiếp tục mua
</a>